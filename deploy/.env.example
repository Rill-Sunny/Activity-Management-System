# Copy to a local ignored env file. Never commit actual credentials.
MYSQL_DATABASE=limited_activities
MYSQL_USER=app_user
MYSQL_PASSWORD=REPLACE_ME
MYSQL_ROOT_PASSWORD=REPLACE_ME
RABBITMQ_USERNAME=app_user
RABBITMQ_PASSWORD=REPLACE_ME
# Project requires Base64 of >=32 random bytes, not a plaintext JWT_SECRET.
JWT_SECRET_BASE64=REPLACE_WITH_BASE64_RANDOM_SECRET
METRICS_PASSWORD=REPLACE_ME
GRAFANA_PASSWORD=REPLACE_ME
SPRING_PROFILES_ACTIVE=docker
# true only when starting the observability profile too.
TRACING_ENABLED=false
APP_IMAGE=las-backend:1.0.0
