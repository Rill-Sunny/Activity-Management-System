  "panels": [
    {
      "id": 1,
      "title": "HTTP RPS",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "x": 0,
        "y": 0.0,
        "w": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(instance)(rate(http_server_requests_seconds_count{job=\"las-backend\",uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "overrides": [],
        "defaults": {
          "unit": "reqps",
          "min": 0
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "placement": "bottom",
          "displayMode": "list"
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP 5xx %",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "x": 8,
        "y": 0.0,
        "w": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum by(instance)(rate(http_server_requests_seconds_count{job=\"las-backend\",status=~\"5..\"}[$__rate_interval])) / clamp_min(sum by(instance)(rate(http_server_requests_seconds_count{job=\"las-backend\"}[$__rate_interval])),0.000001))",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "overrides": [],
        "defaults": {
          "unit": "percent",
          "min": 0
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "placement": "bottom",
          "displayMode": "list"
        }
      }
    },
